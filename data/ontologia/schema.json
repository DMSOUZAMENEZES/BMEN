{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DMSOUZAMENEZES/BMEN/data/ontologia/schema.json",
  "title": "BMEN Ontologia Core v1.x",
  "description": "Esquema versionável da ontologia principal BMEN (classes, propriedades, identificadores e relações).",
  "type": "object",
  "required": ["meta", "domains", "conditions", "signs", "assessments", "interventions", "relations"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["ontology_id", "name", "version", "language", "created_at", "namespaces", "scope"],
      "properties": {
        "ontology_id": {
          "$ref": "#/$defs/snakeId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "language": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date"
        },
        "namespaces": {
          "type": "object",
          "required": ["bmen"],
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "signs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sign"
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intervention"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "snakeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/snakeId"
      }
    },
    "sourceIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^src_[a-z0-9]+(?:_[a-z0-9]+)*$"
      }
    },
    "evidenceIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-z0-9]+(?:_[a-z0-9]+)*$"
      }
    },
    "domain": {
      "type": "object",
      "required": ["id", "label", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/snakeId"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["id", "label", "aliases", "category", "affects_domains", "source_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/snakeId"
        },
        "label": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        },
        "affects_domains": {
          "$ref": "#/$defs/idList"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIdList"
        }
      },
      "additionalProperties": false
    },
    "sign": {
      "type": "object",
      "required": ["id", "label", "related_domains"],
      "properties": {
        "id": {
          "$ref": "#/$defs/snakeId"
        },
        "label": {
          "type": "string"
        },
        "related_domains": {
          "$ref": "#/$defs/idList"
        }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["id", "label", "type", "target_domains", "source_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/snakeId"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "target_domains": {
          "$ref": "#/$defs/idList"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIdList"
        }
      },
      "additionalProperties": false
    },
    "intervention": {
      "type": "object",
      "required": ["id", "label", "type", "target_domains", "indications", "evidence_ids", "source_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/snakeId"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "target_domains": {
          "$ref": "#/$defs/idList"
        },
        "indications": {
          "$ref": "#/$defs/idList"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdList"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIdList"
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["type", "from", "to"],
      "properties": {
        "type": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
