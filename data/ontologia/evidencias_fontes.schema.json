{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DMSOUZAMENEZES/BMEN/data/ontologia/evidencias_fontes.schema.json",
  "title": "BMEN Evidências e Fontes v1.x",
  "description": "Esquema versionável para catálogo de evidências e fontes bibliográficas da ontologia BMEN.",
  "type": "object",
  "required": ["meta", "evidences", "sources"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "version", "language", "created_at"],
      "properties": {
        "name": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "language": { "type": "string" },
        "created_at": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "evidences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "level", "supports_interventions", "source_ids"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ev_[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "statement": { "type": "string", "minLength": 10 },
          "level": {
            "type": "string",
            "enum": ["baixo", "moderado", "alto"]
          },
          "supports_interventions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^src_[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "authors", "year", "url_or_doi", "notes"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^src_[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "title": { "type": "string", "minLength": 3 },
          "authors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "url_or_doi": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
